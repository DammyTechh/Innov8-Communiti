# ─── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=CommUniti
# Public base URL of this API (no trailing slash). On Vercel: https://api.communiti.app
API_URL=http://localhost:4000
# Frontends (used in emails, OAuth redirects and CORS)
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
MOBILE_DEEP_LINK=communiti://
# Extra allowed CORS origins, comma separated (WEB_URL and ADMIN_URL are always allowed)
CORS_ORIGINS=

# ─── Database (Supabase Postgres) ──────────────────────────────────────
# Runtime: Supabase pooler, transaction mode (port 6543). Required on Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations: direct connection or session pooler (port 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Connections per serverless instance (default: 1 in production, 10 in dev)
DB_POOL_MAX=

# ─── Auth ──────────────────────────────────────────────────────────────
# 64+ random chars. To use Supabase Realtime private channels, set this to your
# Supabase project's JWT secret (Settings → API → JWT Secret).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-64-characters-000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# "lax" when web and API share a site (app.communiti.app + api.communiti.app), "none" when they don't
COOKIE_SAMESITE=lax
# e.g. .communiti.app to share the refresh cookie across subdomains; leave empty for localhost
COOKIE_DOMAIN=

# ─── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in Google Cloud console
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Extra client IDs accepted for mobile ID tokens (iOS, Android), comma separated
GOOGLE_MOBILE_CLIENT_IDS=

# ─── Email: Resend over SMTP ───────────────────────────────────────────
# API key: resend.com/api-keys. Password = the key; username is literally "resend".
SMTP_HOST=smtp.resend.com
# 465 = implicit TLS (SMTP_SECURE=true) · 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
#
# TESTING BEFORE DOMAIN VERIFICATION (Resend onboarding):
#   MAIL_FROM="CommUniti <onboarding@resend.dev>"
#   MAIL_REDIRECT_TO=<the email you signed up to Resend with>
# Resend only delivers resend.dev mail to your own account address, so every email
# is redirected there with "[to original@address]" in the subject.
#
# AFTER VERIFYING YOUR DOMAIN (resend.com/domains): use your domain and clear MAIL_REDIRECT_TO.
MAIL_FROM="CommUniti <onboarding@resend.dev>"
MAIL_REDIRECT_TO=
MAIL_REPLY_TO=

# ─── Supabase Storage + Realtime ───────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PUBLIC_BUCKET=public-media
STORAGE_PRIVATE_BUCKET=private-files

# ─── Ops ───────────────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=change-me
# Set automatically by the deploy pipeline (shown in /health)
APP_VERSION=
APP_COMMIT=
# Optional, for Expo push notifications with enhanced security
EXPO_ACCESS_TOKEN=
